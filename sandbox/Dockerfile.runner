FROM python:3.12-slim

RUN useradd --create-home --uid 1000 runner
WORKDIR /workspace
ARG EXTRA_REQS=""
RUN pip install --no-cache-dir "pytest>=8,<9" "pytest-timeout>=2.3,<3" ${EXTRA_REQS}

USER 1000:1000
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    PYTHONPATH=/workspace \
    HOME=/tmp
CMD ["pytest", "-q"]
